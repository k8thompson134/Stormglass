# Backend Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stormglass

# Default location (latitude,longitude) for weather data polling
DEFAULT_LATITUDE=40.7128
DEFAULT_LONGITUDE=-74.0060
DEFAULT_TIMEZONE=America/New_York

# API Keys
# Optional: pollen data is skipped if unset
TOMORROW_API_KEY=
# Optional: hyperlocal ground-sensor AQI overlay is skipped (falls back to the
# regional model) if unset. Free key: https://develop.purpleair.com
PURPLEAIR_API_KEY=

# CORS (comma-separated origins; required in production, omit for permissive dev)
# CORS_ORIGIN=https://stormglass.example.com

# API auth token (required in production, omit to disable auth in dev)
# API_TOKEN=your-secret-token-here

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
# Must match API_TOKEN — baked into the frontend bundle at build time
VITE_API_TOKEN=
