# Backend server (see backend/src/env.ts for validation)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stormglass

# Default location for weather polling (optional; has defaults)
DEFAULT_LATITUDE=40.7128
DEFAULT_LONGITUDE=-74.0060

# Optional: Tomorrow.io API key for pollen data (pollen skipped if unset)
TOMORROW_API_KEY=

# Optional: PurpleAir API key for hyperlocal ground-sensor AQI (falls back to
# Open-Meteo's modeled AQI if unset). Free key: https://develop.purpleair.com
PURPLEAIR_API_KEY=

# Optional: Web Push for AQI category-crossing alerts (push notifications skipped
# entirely if unset). Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then keep the same pair forever -- rotating it invalidates every existing
# subscription and everyone has to re-enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address web push services may use to reach you about this VAPID identity
# (required by the Web Push protocol, not a functional email inbox).
VAPID_SUBJECT=mailto:you@example.com

# Production-only (required when NODE_ENV=production)
# CORS_ORIGIN=https://your-app.example.com
# API_TOKEN=your-secret-bearer-token
