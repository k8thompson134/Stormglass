# Backend server (see backend/src/env.ts for validation)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stormglass

# Default location for weather polling (optional; has defaults)
DEFAULT_LATITUDE=40.7128
DEFAULT_LONGITUDE=-74.0060

# Optional: Tomorrow.io API key for pollen data (pollen skipped if unset)
TOMORROW_API_KEY=

# Production-only (required when NODE_ENV=production)
# CORS_ORIGIN=https://your-app.example.com
# API_TOKEN=your-secret-bearer-token
